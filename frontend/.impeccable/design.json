  "narrative": {
    "northStar": "The Quiet Wayfinder",
    "overview": "NUSGo is warm, approachable, and grounded in the campus it helps people navigate. The shared map remains the main spatial reference; Explore, Stops, and Plan place focused workflows over it so people can keep their bearings while searching, checking arrivals, or planning a trip. Familiar system typography, soft tonal surfaces, and rounded controls make the interface welcoming without taking attention away from places and routes.\n\nThe same control and status language carries across Light, Dark, NUS, Matcha, and Sakura. Soft shadows give panels and floating controls structural separation from the map. Official route colors appear in route-specific contexts; the wider network stays neutral.",
    "keyCharacteristics": [
      "The map carries campus geography while panels carry the current workflow.",
      "Theme-aware surfaces and accents preserve the same control language across all five palettes.",
      "Rounded controls and softly separated cards keep dense transit information approachable.",
      "Route color stays contextual to the selected route."
    ],
    "rules": [
      {
        "name": "The Theme Role Rule",
        "body": "Shared controls use semantic color roles; the selected theme supplies their values.",
        "section": "colors"
      },
      {
        "name": "The Map Separation Rule",
        "body": "Use elevation to clarify which surface sits above the map, while keeping routine controls visually quiet.",
        "section": "elevation"
      },
      {
        "name": "The State Clarity Rule",
        "body": "Selection and status remain clear in text and accessible state; color reinforces the meaning.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the semantic theme variables for shared surfaces, text, borders, accents, and status colors.",
      "Do reserve official route colors for route-specific display, especially the selected route.",
      "Do keep map attribution visible.",
      "Do expose selected states and status meaning through text or accessible semantics as well as color.",
      "Do preserve NUSGo’s independent identity and accurate source attribution."
    ],
    "donts": [
      "Don't hard-code one theme’s accent into shared controls.",
      "Don't color the full network with route colors when no route is selected.",
      "Don't rely on color alone to communicate selection or status.",
      "Don't imply that NUSGo is an official NUS service."
    ]
  }
}
