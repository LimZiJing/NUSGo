# Copy to /opt/navus/backend.env on the server and run `chmod 600` on it. Never commit the copy.
# docker-compose.prod.yml sets NODE_ENV, HOST, PORT, NAVUS_DATA_DIR, NAVUS_DATA_VERSION, and
# VALHALLA_BASE_URL itself, so they are not listed here.

# Exact browser origins allowed to call the API; production entries must use HTTPS.
# The GitHub Pages origin is required. Add the custom frontend origin when it exists.
API_CORS_ORIGINS=https://limzijing.github.io
# Process-local limits; the general API budget includes all routes, with Journey planning capped separately.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120
JOURNEY_RATE_LIMIT_MAX_REQUESTS=20
JOURNEY_MAX_CONCURRENT_REQUESTS=4
JOURNEY_REQUEST_TIMEOUT_MS=10000

# Shuttle refresh and upstream request limits.
NUS_SHUTTLE_REFRESH_INTERVAL_MS=30000
LIVE_DATA_REQUEST_TIMEOUT_MS=5000
LIVE_DATA_MAX_CONCURRENCY=6
LIVE_DATA_RETRY_ATTEMPTS=1
LIVE_DATA_RETRY_BASE_DELAY_MS=200

# NUS internal bus-stop API configuration.
# All four values below are required together to enable NUS live arrivals.
NUS_BUS_PROXY_BASE_URL=https://inetapps.nus.edu.sg
NUS_X_HTD_API=
NUS_X_APP_API=
NUS_X_API_KEY=
NUS_ACCESS_TOKEN_URL=https://myizaac2.nus.edu.sg/univus-public/mobile/get-access-token

# Optional bootstrap values; the backend can refresh an expired session.
NUS_UNIVUS_JWT=
NUS_USER_ID=
# Leave blank to create a stable UUID for the running server or command.
NUS_DEVICE_ID=
NUS_APP_VERSION=univus_android_2.59.2_140
NUS_DOMAIN=PUBLIC
NUS_IPADDR=0.0.0.0

# Optional. Public-bus arrivals are display-only.
LTA_ACCOUNT_KEY=
