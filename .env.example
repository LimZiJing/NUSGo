# Frontend settings loaded by Vite from the repository root.
# Leave the API origin blank to use the local Vite proxy. Set it when the
# frontend and Express API are served from different origins.
VITE_API_ORIGIN=

# Local Valhalla endpoint used by the development frontend.
VITE_VALHALLA_BASE_URL=http://localhost:8002
VITE_DATA_VERSION=development
