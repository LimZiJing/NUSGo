# Local NUS internal bus-stop API configuration.
# Copy this file to .env and fill in the values supplied for your test account.

NUS_BUS_PROXY_BASE_URL=https://inetapps.nus.edu.sg
NUS_X_API_KEY=

# Use an already-issued JWT and its matching userid from a working session.
NUS_UNIVUS_JWT=
NUS_USER_ID=

# Leave blank to create a fresh UUID for each command.
NUS_DEVICE_ID=

NUS_APP_VERSION=2.56.0
NUS_DOMAIN=PUBLIC
NUS_IPADDR=0.0.0.0
