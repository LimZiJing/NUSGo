# Copy to /opt/navus/compose.env on the server and run `chmod 600` on it. Never commit the copy.
# Read by docker compose for variable substitution in docker-compose.prod.yml.

# Backend-only environment file; see deploy/backend.env.example.
NAVUS_BACKEND_ENV_FILE=/opt/navus/backend.env

# Directory holding valhalla.json, valhalla_tiles, and valhalla_tiles.tar.
NAVUS_VALHALLA_DATA_DIR=/opt/navus/valhalla

# Token from the Cloudflare Tunnel's install command. It grants access to the tunnel.
TUNNEL_TOKEN=
