# Local NUS internal bus-stop API configuration.
# Copy this file to .env and fill in the values supplied for your test account.

NUS_BUS_PROXY_BASE_URL=https://inetapps.nus.edu.sg
NUS_X_HTD_API=
NUS_X_APP_API=
NUS_X_API_KEY=
NUS_ACCESS_TOKEN_URL=https://myizaac2.nus.edu.sg/univus-public/mobile/get-access-token

# Optional bootstrap values. They are refreshed in memory when the NUS API
# reports code 10011 (expired session).
NUS_UNIVUS_JWT=
NUS_USER_ID=

# Leave blank to create a stable UUID for the running server or command.
NUS_DEVICE_ID=

# LTA DataMall API account key for public bus timings
LTA_ACCOUNT_KEY=

# The ESB version string used by the Android app: distribution_platform_version_build.
NUS_APP_VERSION=univus_android_2.59.2_140
NUS_DOMAIN=PUBLIC
NUS_IPADDR=0.0.0.0

# Local Valhalla endpoint used by the development server.
VITE_VALHALLA_BASE_URL=http://localhost:8002
